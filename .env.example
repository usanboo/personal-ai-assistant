# Copy this file to ".env" and fill in your own values.
# No spaces, no < > brackets. A Gmail app password is exactly 16 lowercase letters.
# Keep .env private (chmod 600) and never commit it.

# --- Telegram ---
TELEGRAM_TOKEN=
OWNER_CHAT_ID=

# --- Gmail box 1 (main) --- use an app password, NOT your login password
GMAIL_MAIN_USER=
GMAIL_MAIN_PASS=

# --- Gmail box 2 (optional) ---
GMAIL_JOB_USER=
GMAIL_JOB_PASS=

# --- Exchange / Outlook mailbox via EWS (optional) ---
EWS_USER=
EWS_PASSWORD=
EWS_ADDRESS=
EWS_SERVER=

# --- Optional overrides ---
# CLAUDE_BIN=claude
# AI_MODEL=claude-sonnet-5-5
# GCAL_ID=primary
